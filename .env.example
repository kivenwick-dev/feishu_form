# 飞书企业自建应用凭据。不要把真实 .env 提交到 Git。
FEISHU_APP_ID=cli_xxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxx

# 云服务器对外监听的 IP 和端口。
# 0.0.0.0 表示允许外部访问；如果只想让 Nginx 本机反代，可改成 127.0.0.1。
REIMBURSEMENT_PUBLIC_HOST=0.0.0.0
REIMBURSEMENT_PORT=8765

# 容器内输出目录和宿主机持久化目录。
# 页面默认会使用容器内目录 /data/outputs；宿主机可在 ./outputs 中看到同一份文件。
REIMBURSEMENT_OUTPUT_DIR=/data/outputs
REIMBURSEMENT_HOST_OUTPUT_DIR=./outputs
REIMBURSEMENT_DISABLE_FOLDER_PICKER=1

# 云服务器 outputs 自动清理：默认保留 24 小时，每 1 小时扫描一次。
# 设置为 0 可关闭；也可以改成 2h、30m 等 Go duration 格式。
REIMBURSEMENT_OUTPUT_RETENTION=24h
REIMBURSEMENT_OUTPUT_CLEANUP_INTERVAL=1h

TZ=Asia/Shanghai
